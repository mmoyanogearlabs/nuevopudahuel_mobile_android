<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/backgroundhome"
    tools:ignore="MissingPrefix">

    <ImageButton
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:src="@drawable/btnmenu"
        android:background="@android:color/transparent"
        android:layout_alignParentRight="true"
        android:padding="@dimen/padding_10"
        android:id="@+id/home_menu_button" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:animateLayoutChanges="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:id="@+id/dashboard_container"
            android:gravity="top">

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:id="@+id/dashboard_weather_container">

                <RelativeLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/dashboard_weather_icon"
                        android:layout_marginTop="@dimen/padding_20"/>

                    <TextView
                        fontPath="@string/avenir_book"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="@dimen/padding_10"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textSize75"
                        android:id="@+id/dashboard_weather_text"
                        android:layout_toRightOf="@+id/dashboard_weather_icon"/>

                    <TextView
                        fontPath="@string/avenir_book"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/white"
                        android:textSize="@dimen/textSize30"
                        android:id="@+id/dashboard_weather_degrees"
                        android:text="º"
                        android:layout_toRightOf="@+id/dashboard_weather_text"
                        android:layout_marginTop="@dimen/padding_10"/>

                </RelativeLayout>

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/logohomebig"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginLeft="@dimen/padding_30"
                    android:layout_marginRight="@dimen/padding_30"
                    android:layout_marginTop="@dimen/padding_3">

                    <TextView
                        fontPath="@string/avenir_book"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:text="@string/homeWaitTimeTitleKey"
                        android:textColor="@color/grey"/>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:layout_marginRight="@dimen/padding_3"
                            android:padding="@dimen/padding_3"
                            android:background="@drawable/dashboard_wait_background"
                            android:gravity="center">

                            <TextView
                                fontPath="@string/avenir_book"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/homeWaitTimeNationalTitleKey"
                                android:textColor="@color/darkGrey"
                                android:autoSizeTextType="uniform"
                                android:layout_marginRight="@dimen/padding_5"/>

                            <TextView
                                fontPath="@string/avenir_book"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/red"
                                android:autoSizeTextType="uniform"
                                android:id="@+id/home_wait_national"/>

                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="horizontal"
                            android:layout_marginLeft="@dimen/padding_3"
                            android:padding="@dimen/padding_3"
                            android:background="@drawable/dashboard_wait_background"
                            android:gravity="center">

                            <TextView
                                fontPath="@string/avenir_book"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/homeWaitTimeInternationalTitleKey"
                                android:textColor="@color/darkGrey"
                                android:autoSizeTextType="uniform"
                                android:layout_marginRight="@dimen/padding_5"/>

                            <TextView
                                fontPath="@string/avenir_book"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/red"
                                android:layout_alignParentRight="true"
                                android:autoSizeTextType="uniform"
                                android:id="@+id/home_wait_international"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

            </LinearLayout>

            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:id="@+id/dashboard_bottom_layout"
                android:gravity="center">

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal">

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_salidashome_selector"
                        android:id="@+id/dash_salidas_container"
                        android:gravity="center">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom">

                            <ImageView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_gravity="center"
                                android:src="@drawable/btnsalidasvuelosicon" />

                            <TextView
                                fontPath="@string/economica_bold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginLeft="@dimen/padding_10"
                                android:text="@string/homeDepartureButtonTitleKey"
                                android:textSize="16sp"
                                android:id="@+id/textView" />

                        </LinearLayout>

                    </LinearLayout>

                    <LinearLayout
                        android:orientation="horizontal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/btn_llegadashome_selector"
                        android:id="@+id/dash_llegadas_container"
                        android:gravity="center">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="bottom">

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/btniconllegadasvuelos" />

                        <TextView
                            fontPath="@string/economica_bold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="@dimen/padding_10"
                            android:text="@string/homeArribalButtonTitleKey"
                            android:textSize="@dimen/textSize16"/>

                        </LinearLayout>

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:orientation="horizontal"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:weightSum="3"
                    android:id="@+id/dash_search_container">

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="2"
                        android:background="@drawable/dash_rounded_left_grey"
                        android:id="@+id/dash_search_layout">

                        <EditText
                            fontPath="@string/avenir_roman"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:hint="@string/homeSearchFlightPlaceholderTextKey"
                            android:textSize="@dimen/textSize15"
                            android:background="@android:color/transparent"
                            android:gravity="center_vertical"
                            android:paddingLeft="@dimen/padding_20"
                            android:paddingRight="@dimen/padding_10"
                            android:singleLine="true"
                            android:id="@+id/dash_editText"
                            android:layout_toLeftOf="@+id/dash_icon_lupa" />

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:src="@drawable/iconlupa"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:layout_marginRight="@dimen/padding_5"
                            android:id="@+id/dash_icon_lupa" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/btn_misvuelos_selector"
                        android:id="@+id/dash_button_myflights">

                        <TextView
                            fontPath="@string/economica_bold"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginLeft="@dimen/padding_10"
                            android:gravity="center"
                            android:layout_toLeftOf="@+id/dash_img_myflights"
                            android:text="@string/homeMyFlightsButtonTitleKey"
                            android:autoSizeTextType="uniform"
                            android:textColor="@color/white"
                            android:id="@+id/dashboard_myflights_text"/>

                        <ImageView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/dash_img_myflights"
                            android:layout_centerVertical="true"
                            android:layout_alignParentRight="true"
                            android:src="@drawable/btnmisvuelosicon"
                            android:layout_marginRight="@dimen/padding_10"/>

                    </RelativeLayout>

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <com.massiva.nuevopudahuel.banners.BannerView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:screenName="@string/banner_screen_home"
            app:autoLoad="true"
            android:id="@+id/dashboard_banner"
            android:layout_alignParentBottom="true"/>

    </RelativeLayout>

</RelativeLayout>