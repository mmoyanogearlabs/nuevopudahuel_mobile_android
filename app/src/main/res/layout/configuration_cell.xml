<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/configuration_cell"
            android:padding="@dimen/padding_5">

        <TextView
            fontPath="@string/avenir_roman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginLeft="@dimen/padding_5"
            android:id="@+id/configuration_text"
            android:layout_toLeftOf="@+id/configuration_check"/>

        <Switch
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:id="@+id/configuration_check"
            android:layout_alignParentRight="true"
            android:thumb="@drawable/custom_switch_shape"
            android:track="@drawable/custom_switch_selector"
            android:switchMinWidth="@dimen/padding_15"
            android:textOn=""
            android:textOff=""/>

        </RelativeLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:src="@color/softGrey" />

    </LinearLayout>

</RelativeLayout>