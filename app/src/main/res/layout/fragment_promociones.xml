<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/padding_10"
        android:background="@color/grey"
        android:id="@+id/flights_header_container">

        <TextView
            fontPath="@string/avenir_roman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/menuOptionPromosTitleKey"
            android:textSize="@dimen/textSize20"
            android:textColor="@color/softBlue"
            android:layout_centerHorizontal="true"
            android:id="@+id/flights_tittle"/>

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btnmenu"
            android:layout_centerVertical="true"
            android:id="@+id/home_menu_button"
            android:layout_alignParentRight="true"/>

    </RelativeLayout>

    <com.cleverox.nuevopudahuel.ui.scanner.ScannerView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/promociones_scanner">

    </com.cleverox.nuevopudahuel.ui.scanner.ScannerView>


</LinearLayout>