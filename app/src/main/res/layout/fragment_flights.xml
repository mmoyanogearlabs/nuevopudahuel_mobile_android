<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:orientation="vertical" android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:ignore="MissingPrefix" >

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_alignParentTop="true"
        android:padding="@dimen/padding_10"
        android:background="@color/grey"
        android:id="@+id/flights_header_container">

        <TextView
            fontPath="@string/avenir_roman"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/flightHeaderFlightTitleKey"
            android:textSize="@dimen/textSize20"
            android:textColor="@color/softBlue"
            android:layout_centerHorizontal="true"
            android:id="@+id/flights_tittle"/>

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/btnmenu"
            android:layout_centerVertical="true"
            android:id="@+id/home_menu_button"
            android:layout_alignParentRight="true"/>

    </RelativeLayout>

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/white"
        android:id="@+id/flights_editText_container"
        android:layout_below="@+id/flights_header_container">

        <EditText
            fontPath="@string/avenir_roman"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@android:color/transparent"
            android:hint="@string/homeSearchFlightPlaceholderTextKey"
            android:textSize="@dimen/textSize15"
            android:layout_marginLeft="@dimen/padding_5"
            android:padding="@dimen/padding_5"
            android:singleLine="true"
            android:id="@+id/flights_editText"/>

        <ImageButton
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:background="@drawable/iconlupa"
            android:layout_alignParentRight="true"
            android:layout_marginRight="@dimen/padding_10"
            android:id="@+id/flights_search"/>

    </RelativeLayout>

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/flights_container"
        android:layout_gravity="center_horizontal"
        android:layout_alignParentBottom="true"
        android:layout_below="@id/flights_editText_container">

    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/flights_a">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_flights_selector"
            android:id="@+id/flights_salidas_container"
            android:gravity="center">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="bottom">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:src="@drawable/btnsalidasvuelosicon" />

                <TextView
                    fontPath="@string/economica_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/padding_10"
                    android:text="@string/homeDepartureButtonTitleKey"
                    android:textSize="16sp"/>

            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/btn_flights_selector"
            android:id="@+id/flights_llegadas_container"
            android:gravity="center">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="bottom">

                <ImageView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/btniconllegadasvuelos" />

                <TextView
                    fontPath="@string/economica_bold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="@dimen/padding_10"
                    android:text="@string/homeArribalButtonTitleKey"
                    android:textSize="@dimen/textSize16"/>

               </LinearLayout>

           </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="#313030"
            android:id="@+id/flights_menu">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:padding="@dimen/padding_10"
                android:background="@android:color/transparent"
                android:text="@string/flightHeaderFlightTitleKey"
                android:textColor="@color/white"
                android:id="@+id/flights_vuelos_button"
                android:textAllCaps="false"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2.3"
                android:padding="@dimen/padding_10"
                android:background="@android:color/transparent"
                android:text="@string/flightHeaderDestinationTitleKey"
                android:textColor="@color/white"
                android:id="@+id/flights_origen_button"
                android:textAllCaps="false"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1.2"
                android:padding="@dimen/padding_10"
                android:background="@android:color/transparent"
                android:text="@string/flightHeaderTimeTitleKey"
                android:textColor="@color/white"
                android:id="@+id/flights_tiempo_button"
                android:textAllCaps="false"/>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:padding="@dimen/padding_10"
                android:background="@android:color/transparent"
                android:text="@string/flightHeaderStatusTitleKey"
                android:textColor="@color/white"
                android:id="@+id/flights_estado_button"
                android:textAllCaps="false"/>

        </LinearLayout>

        <android.support.v7.widget.RecyclerView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/flights_list">

        </android.support.v7.widget.RecyclerView>

    </LinearLayout>

</RelativeLayout>